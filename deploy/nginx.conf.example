# Include inside nginx's http {} context. Obtain a trusted certificate first.
# Configure DNS and substitute bot.example.com/certificate paths before use.
limit_req_zone $binary_remote_addr zone=sentinel_requests:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=sentinel_connections:10m;

server {
    listen 443 ssl;
    server_name bot.example.com;
    ssl_certificate /etc/letsencrypt/live/bot.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bot.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 64k;
    client_body_buffer_size 64k;
    large_client_header_buffers 2 8k;
    client_header_timeout 5s;
    client_body_timeout 5s;
    keepalive_timeout 10s;
    send_timeout 10s;
    access_log off;

    location = /interactions {
        limit_except POST { deny all; }
        limit_req zone=sentinel_requests burst=40 nodelay;
        limit_conn sentinel_connections 20;
        proxy_request_buffering on;
        proxy_http_version 1.0;
        proxy_set_header Host $host;
        proxy_set_header Connection close;
        proxy_connect_timeout 2s;
        proxy_send_timeout 5s;
        proxy_read_timeout 5s;
        proxy_pass http://127.0.0.1:8080;
    }

    location = /healthz {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://127.0.0.1:8080;
    }
    location / { return 404; }
}
